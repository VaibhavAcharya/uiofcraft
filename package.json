{
  "name": "uiofcraft",
  "version": "0.0.0",
  "description": "Shared React components, styles and fonts, built on coss ui",
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.18.0",
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@remixicon/react": "^4.9.0",
    "@storybook/react-vite": "^10.6.6",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-table": "^9.3.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "date-fns": "^4.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.6",
    "tailwindcss": "^4.3.5",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@daypicker/react": "^10.0.2",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/components/ui/*.d.ts",
      "default": "./dist/components/ui/*.js"
    },
    "./craft/*": {
      "types": "./dist/components/craft/*.d.ts",
      "default": "./dist/components/craft/*.js"
    },
    "./hooks/*": {
      "types": "./dist/hooks/*.d.ts",
      "default": "./dist/hooks/*.js"
    },
    "./styles.css": "./dist/styles/index.css",
    "./theme.css": "./dist/styles/theme.css",
    "./fonts.css": "./dist/styles/fonts.css"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome check --write",
    "storybook": "storybook dev --port 6008",
    "build-storybook": "storybook build --output-dir storybook-static",
    "dev": "tsdown --watch",
    "generate-stories": "node scripts/generate-stories.ts && biome check --write stories"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VaibhavAcharya/uiofcraft.git"
  }
}
